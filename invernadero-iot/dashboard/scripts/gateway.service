# Pasarela (gateway) de la Raspberry Pi: arranca sola con la Pi y se reinicia si se cae.
#   1) Edite User y las rutas de WorkingDirectory/ExecStart (donde copió el proyecto).
#   2) sudo cp gateway.service /etc/systemd/system/
#   3) sudo systemctl daemon-reload && sudo systemctl enable --now gateway
#   Ver el estado:  journalctl -u gateway -f        Salud:  curl http://localhost:3100/api/health
[Unit]
Description=Pasarela del invernadero (nodos -> Supabase)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/invernadero-iot/dashboard
ExecStart=/usr/bin/npm run gateway
Environment=GATEWAY_PORT=3100
Environment=GATEWAY_FORWARD_S=2
Restart=always
RestartSec=5
# Al detener el servicio se hace un ultimo envio a Supabase (hasta 10 s).
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target

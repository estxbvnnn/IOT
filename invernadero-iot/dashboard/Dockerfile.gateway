# Imagen de las HERRAMIENTAS de la Raspberry Pi (linux/arm64; también sirve en x86): pasarela MQTT, sincronización con Supabase,
# migraciones y scripts (claves de API, arranque inicial). Todas son scripts TypeScript que corren con tsx.
# Se construye desde invernadero-iot/ (el contexto debe incluir supabase/migrations):  docker compose up -d --build
FROM node:22-slim
WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY dashboard/tsconfig.json ./
COPY dashboard/src ./src
COPY dashboard/scripts ./scripts
# db-migrate.ts busca las migraciones en <carpeta del dashboard>/../supabase/migrations  →  /supabase/migrations
COPY supabase /supabase

ENV NODE_ENV=production
# Los scripts no necesitan privilegios: se ejecutan como el usuario «node» (el código queda de solo lectura para él).
USER node
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.GATEWAY_PORT||3100)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# node --import tsx (sin npm ni intermediarios): SIGTERM llega directo y el proceso cierra ordenadamente.
CMD ["node", "--import", "tsx", "scripts/gateway.ts"]

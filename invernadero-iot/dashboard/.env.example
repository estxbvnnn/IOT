# ============================================================
#  Variables de entorno del dashboard  (copiar a .env.local)
#  `npm run setup` genera .env.local y .env.admin.local por ti.
# ============================================================

# --- Supabase (PostgreSQL) -----------------------------------
# IMPORTANTE: la conexión directa db.<ref>.supabase.co solo tiene IPv6.
# Si tu red es IPv4 usa el pooler de Supabase (Connect → Session pooler):
#   host  = aws-0-<region>.pooler.supabase.com
#   user  = <rol>.<project-ref>
DATABASE_HOST=aws-0-us-west-2.pooler.supabase.com
DATABASE_PORT=5432          # 5432 = pooler en modo sesión · 6543 = modo transacción (serverless)
DATABASE_NAME=postgres

# Rol de la APLICACIÓN (mínimo privilegio; lo crea la migración). No es «postgres».
DATABASE_USER=iot_app.<project-ref>
DATABASE_PASSWORD=<contraseña-larga-aleatoria>

# verify (por defecto: TLS con la CA de Supabase) | no-verify | disable
DATABASE_SSL_MODE=verify

# --- Aplicación ----------------------------------------------
# Clave maestra: cifra los secretos TOTP en reposo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=<clave-aleatoria-de-32-bytes>

# Perfiles que DEBEN activar segundo factor (TOTP), separados por coma.
# El informe exige 2FA para administrador y dueño en producción.
MFA_REQUIRED_ROLES=

# true solo detrás de HTTPS (activa cookies Secure y HSTS)
FORCE_HTTPS=false

# ------------------------------------------------------------
#  .env.admin.local  (SOLO para scripts de migración y seed;
#  la aplicación web nunca lo carga)
# ------------------------------------------------------------
# DATABASE_ADMIN_USER=postgres.<project-ref>
# DATABASE_ADMIN_PASSWORD=<contraseña de postgres>

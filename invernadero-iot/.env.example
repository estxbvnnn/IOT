# Copie a .env (en la Raspberry Pi, junto a docker-compose.yml) y cambie TODAS las claves.
# Genere cada clave con:  openssl rand -base64 24 | tr -d '/+='

# --- Mosquitto: credenciales de los nodos y de la pasarela (van igual en el firmware: MQTT_USER / MQTT_PASS) ---
MQTT_USER=nodo
MQTT_PASS=cambiar-esta-clave

# --- Cifrado del payload MQTT (AES-256-GCM; ver docs/cifrado-mqtt.md) ---
# Clave de 64 caracteres hex, la MISMA que lleva el firmware (AES_KEY_HEX):  openssl rand -hex 32
MQTT_AES_KEY=
# permitir = acepta claro, Base64, AES y RSA (para probar)  ·  exigir = solo AES o RSA  ·  exigir-rsa = solo clave pública/privada (RSA)
# La clave PRIVADA RSA va en secrets/mqtt-rsa-private.pem (solo en la Pi; ver docs/cifrado-mqtt.md §5)
MQTT_CIFRADO=permitir

# --- Base de datos local (PostgreSQL en la Pi) ---
POSTGRES_PASSWORD=cambiar-clave-del-administrador-de-la-base
IOT_APP_PASSWORD=cambiar-clave-del-rol-iot_app

# --- Dashboard ---
APP_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres
MFA_REQUIRED_ROLES=
TZ=America/Santiago

# --- Envío a la nube (servicio «uplink»: la Pi manda a AWS lo nuevo cada UPLINK_INTERVAL_S segundos, cifrado) ---
# Sin AWS_UPLINK_URL el servicio queda inactivo y la Pi funciona igual en local.
AWS_UPLINK_URL=
AWS_UPLINK_API_KEY=
# Clave PÚBLICA RSA de AWS (PEM) dentro de ./secrets, vista en el contenedor como /run/secrets/<archivo>. La privada solo la tiene AWS.
AWS_PUBLIC_KEY_FILE=
UPLINK_INTERVAL_S=5
UPLINK_SIN_CIFRAR=0

# --- Copia a Supabase (servicio «sync», OPCIONAL: ya no es el camino principal a la nube) ---
SYNC_INTERVAL_S=300
# Rol «iot_app» de Supabase (el pooler de Supabase habla IPv4: aws-0-<region>.pooler.supabase.com, usuario iot_app.<id-del-proyecto>)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_MODE=verify

# PRUEBAS (malla ESP-NOW): 1 = la pasarela acepta cualquier identificador como credencial y da de alta los nodos nuevos. NO en produccion
ACEPTAR_NODOS_NUEVOS=0

# Copie a .env (en la Raspberry Pi, junto a docker-compose.yml) y cambie TODAS las claves.
# Genere cada clave con:  openssl rand -base64 24 | tr -d '/+='

# --- Mosquitto: credenciales de los nodos y de la pasarela (van igual en el firmware: MQTT_USER / MQTT_PASS) ---
MQTT_USER=nodo
MQTT_PASS=cambiar-esta-clave

# --- Base de datos local (PostgreSQL en la Pi) ---
POSTGRES_PASSWORD=cambiar-clave-del-administrador-de-la-base
IOT_APP_PASSWORD=cambiar-clave-del-rol-iot_app

# --- Dashboard ---
APP_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres
MFA_REQUIRED_ROLES=
TZ=America/Santiago

# --- Copia a Supabase (servicio «sync», cada SYNC_INTERVAL_S segundos) ---
SYNC_INTERVAL_S=300
# Rol «iot_app» de Supabase (el pooler de Supabase habla IPv4: aws-0-<region>.pooler.supabase.com, usuario iot_app.<id-del-proyecto>)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_MODE=verify
